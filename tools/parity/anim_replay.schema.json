{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "unityrs animation replay recording",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "spec", "capture"],
  "properties": {
    "format": {"const": "unityrs.anim_replay"},
    "version": {"const": 1},
    "spec": {"$ref": "#/$defs/spec"},
    "capture": {"$ref": "#/$defs/capture"},
    "baseline_captures": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/recording"}}
  },
  "$defs": {
    "recording": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "version", "spec", "capture"],
      "properties": {
        "format": {"const": "unityrs.anim_replay"}, "version": {"const": 1},
        "spec": {"$ref": "#/$defs/spec"}, "capture": {"$ref": "#/$defs/capture"}
      }
    },
    "name": {"type": "string", "minLength": 1},
    "index": {"type": "integer", "minimum": 0, "maximum": 2147483647},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "f32": {"type": "string", "pattern": "^[0-9a-f]{8}$"},
    "address": {"type": "string", "pattern": "^((0|[1-9][0-9]*)(/(0|[1-9][0-9]*))*)?$"},
    "asset": {"type": "string", "pattern": "^[^/\\\\:]+(/[^/\\\\:]+)*$"},
    "id": {
      "type": "object", "additionalProperties": false,
      "required": ["bundle", "file_index", "file", "path_id"],
      "properties": {
        "bundle": {"$ref": "#/$defs/index"}, "file_index": {"$ref": "#/$defs/index"},
        "file": {"$ref": "#/$defs/asset"}, "path_id": {"type": "string", "pattern": "^(0|-?[1-9][0-9]{0,18})$"}
      }
    },
    "optional_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "bundle": {
      "type": "object", "additionalProperties": false, "required": ["name", "sha256"],
      "properties": {"name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"}, "sha256": {"$ref": "#/$defs/digest"}}
    },
    "timepoint": {
      "type": "object", "additionalProperties": false, "required": ["local"],
      "properties": {"local": {"type": "number", "minimum": 0}, "muscles": {"type": "array", "minItems": 1, "items": {"type": "number", "minimum": -1, "maximum": 1}}}
    },
    "node": {
      "type": "object", "additionalProperties": false, "required": ["address", "name", "id"],
      "properties": {"address": {"$ref": "#/$defs/address"}, "name": {"type": "string"}, "id": {"$ref": "#/$defs/id"}}
    },
    "channel": {
      "type": "object", "additionalProperties": false, "required": ["index", "name", "full_weights"],
      "properties": {
        "index": {"$ref": "#/$defs/index"}, "name": {"$ref": "#/$defs/name"},
        "full_weights": {"type": "array", "minItems": 1, "items": {"type": "number"}}
      }
    },
    "renderer": {
      "type": "object", "additionalProperties": false,
      "required": ["address", "component", "id", "mesh", "channels"],
      "properties": {
        "address": {"$ref": "#/$defs/address"}, "component": {"$ref": "#/$defs/index"},
        "id": {"$ref": "#/$defs/id"}, "mesh": {"$ref": "#/$defs/id"},
        "channels": {"type": "array", "items": {"$ref": "#/$defs/channel"}}
      }
    },
    "setting": {
      "type": "object", "additionalProperties": false,
      "required": ["property", "effective", "serialized_path", "serialized"],
      "properties": {
        "property": {"$ref": "#/$defs/name"}, "effective": {},
        "serialized_path": {"$ref": "#/$defs/name"}, "serialized": {}
      }
    },
    "discovery": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "field", "ordinal", "original", "resolved", "outcome"],
      "properties": {
        "owner": {"$ref": "#/$defs/id"}, "field": {"$ref": "#/$defs/name"},
        "ordinal": {"$ref": "#/$defs/index"}, "original": {"$ref": "#/$defs/optional_id"},
        "resolved": {"$ref": "#/$defs/optional_id"}, "outcome": {"$ref": "#/$defs/name"}
      }
    },
    "humanoid": {
      "type": "object", "additionalProperties": false,
      "required": ["absent_slot", "slots", "axes", "disposition"],
      "properties": {
        "absent_slot": {"type": "integer"},
        "slots": {
          "type": "array", "items": {"$ref": "#/$defs/slot"},
          "allOf": [
            {"title": "goal inventory row", "contains": {"required": ["kind"], "properties": {"kind": {"const": "goal"}}}},
            {"title": "translation inventory row", "contains": {"required": ["kind"], "properties": {"kind": {"const": "translation"}}}}
          ]
        },
        "axes": {"type": "array", "items": {"$ref": "#/$defs/axis"}},
        "disposition": {"type": "string", "pattern": "^(pending|qualified_muscle_only|unsupported_[a-z_]+)$"},
        "storage_counts": {"type": "object", "additionalProperties": false,
          "required": ["streamed", "dense", "constant"], "properties": {
            "streamed": {"$ref": "#/$defs/index"}, "dense": {"$ref": "#/$defs/index"}, "constant": {"$ref": "#/$defs/index"}}},
        "root_hips_comparison": {"type": "object", "additionalProperties": false,
          "required": ["baseline_capture_id", "root_node", "hips_node"],
          "properties": {"baseline_capture_id": {"$ref": "#/$defs/digest"}, "root_node": {"$ref": "#/$defs/index"},
            "hips_node": {"$ref": "#/$defs/index"}}}
      }
    },
    "slot": {
      "type": "object", "additionalProperties": false, "required": ["dof", "kind", "index_value", "storage"],
      "properties": {"dof": {"$ref": "#/$defs/name"}, "kind": {"enum": ["body", "muscle", "goal", "translation"]},
        "index_value": {"type": "integer"}, "storage": {"enum": ["absent", "streamed", "dense", "constant"]}}
    },
    "axis": {
      "type": "object", "additionalProperties": false, "required": ["bone", "axis_type", "pre", "post", "sign", "min", "max"],
      "properties": {"bone": {"$ref": "#/$defs/index"}, "axis_type": {"type": "integer"},
        "pre": {"$ref": "#/$defs/vec4"}, "post": {"$ref": "#/$defs/vec4"},
        "sign": {"$ref": "#/$defs/vec3"}, "min": {"$ref": "#/$defs/vec3"}, "max": {"$ref": "#/$defs/vec3"}}
    },
    "evidence": {
      "type": "object",
      "required": ["layout", "clock", "import_settings", "discovery"],
      "properties": {
        "layout": {"$ref": "#/$defs/name"}, "clock": {"$ref": "#/$defs/clock_evidence"},
        "import_settings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/setting"}},
        "discovery": {"type": "array", "items": {"$ref": "#/$defs/discovery"}},
        "humanoid": {"$ref": "#/$defs/humanoid"}
      }
    },
    "clock_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "stop", "key_times", "held"],
      "properties": {
        "start": {"$ref": "#/$defs/endpoint"}, "stop": {"$ref": "#/$defs/endpoint"},
        "key_times": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "authored_key_times": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "held": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["source", "right"], "properties": {
            "source": {"type": "number"}, "left": {"$ref": "#/$defs/probe"}, "right": {"$ref": "#/$defs/probe"}}}}
      }
    },
    "endpoint": {
      "type": "object", "additionalProperties": false, "required": ["source", "field", "probe"],
      "properties": {"source": {"type": "number"}, "field": {"$ref": "#/$defs/name"}, "probe": {"$ref": "#/$defs/probe"}}
    },
    "probe": {
      "type": "object", "additionalProperties": false,
      "required": ["sample", "property", "target", "channel", "component", "value"],
      "properties": {
        "sample": {"$ref": "#/$defs/index"}, "property": {"enum": ["translation", "rotation", "scale", "weight"]},
        "target": {"$ref": "#/$defs/index"}, "channel": {"type": "integer", "minimum": -1},
        "component": {"$ref": "#/$defs/index"}, "value": {"$ref": "#/$defs/f32"}
      }
    },
    "interval": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"type": "number", "minimum": -1e30, "maximum": 1e30}
    },
    "stage": {
      "type": "object", "additionalProperties": false, "required": ["stage", "range"],
      "properties": {
        "stage": {"enum": ["rest", "constant", "held", "streamed", "dense", "hermite", "weighted", "muscle", "joint"]},
        "range": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/interval"}},
        "norm_ranges": {"type": "array", "minItems": 1, "items": {
          "type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/interval"}}}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["property", "target", "channel", "track_kind", "stages"],
      "anyOf": [
        {"properties": {"property": {"enum": ["translation", "scale"]}}, "required": ["component_ranges"]},
        {"properties": {"property": {"enum": ["rotation", "weight"]}, "component_ranges": false}}
      ],
      "properties": {
        "property": {"enum": ["translation", "rotation", "scale", "weight"]},
        "target": {"$ref": "#/$defs/index"}, "channel": {"type": "integer", "minimum": -1, "maximum": 2147483647},
        "weight_units": {"enum": ["editor", "fraction_of_100"]},
        "track_kind": {"enum": ["rest", "constant", "held", "streamed", "dense", "hermite", "weighted",
          "euler_constant", "euler_held", "euler_streamed", "euler_dense", "euler_hermite", "euler_weighted",
          "muscle_constant", "muscle_streamed", "muscle_dense"]},
        "stages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stage"}},
        "component_ranges": {"type": "array", "minItems": 3, "maxItems": 3, "items": {
          "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/interval"}}}
      }
    },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["bundles", "build_target", "prefab", "prefab_asset", "clip", "clip_asset", "clip_name", "binding", "binding_address", "binding_component", "avatar", "avatar_asset", "mode", "start", "stop", "sample_rate", "source_clock", "held_boundaries", "schedule", "nodes", "renderers", "evidence"],
      "properties": {
        "bundles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bundle"}},
        "build_target": {"$ref": "#/$defs/name"},
        "prefab": {"$ref": "#/$defs/id"}, "prefab_asset": {"$ref": "#/$defs/asset"},
        "clip": {"$ref": "#/$defs/id"}, "clip_asset": {"$ref": "#/$defs/asset"}, "clip_name": {"type": "string"},
        "binding": {"$ref": "#/$defs/id"}, "binding_address": {"$ref": "#/$defs/address"},
        "binding_component": {"$ref": "#/$defs/index"},
        "avatar": {"$ref": "#/$defs/optional_id"}, "avatar_asset": {"type": "string"},
        "mode": {"enum": ["animator", "legacy", "human_pose"]},
        "start": {"type": "number"}, "stop": {"type": "number"},
        "sample_rate": {"type": "number", "exclusiveMinimum": 0},
        "source_clock": {"enum": ["widened", "f32_add"]},
        "held_boundaries": {"type": "array", "items": {"type": "number"}},
        "schedule": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/timepoint"}},
        "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
        "renderers": {"type": "array", "items": {"$ref": "#/$defs/renderer"}},
        "evidence": {"$ref": "#/$defs/evidence"},
        "budgets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/budget"}},
        "editor_axis_properties": {"type": "array", "items": {"$ref": "#/$defs/name"}}
      }
    },
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/f32"}},
    "vec4": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/f32"}},
    "trs": {
      "type": "object", "additionalProperties": false, "required": ["translation", "rotation", "scale"],
      "properties": {
        "translation": {"$ref": "#/$defs/vec3"}, "rotation": {"$ref": "#/$defs/vec4"}, "scale": {"$ref": "#/$defs/vec3"}
      }
    },
    "weights": {
      "type": "object", "additionalProperties": false, "required": ["channels"],
      "properties": {"channels": {"type": "array", "items": {"$ref": "#/$defs/f32"}}}
    },
    "pose": {
      "type": "object", "additionalProperties": false, "required": ["transforms", "weights"],
      "properties": {
        "transforms": {"type": "array", "items": {"$ref": "#/$defs/trs"}},
        "weights": {"type": "array", "items": {"$ref": "#/$defs/weights"}}
      }
    },
    "sample": {
      "type": "object", "additionalProperties": false, "required": ["local", "local_f32", "source", "effective_source", "sides", "muscles_f32", "pose"],
      "properties": {
        "local": {"type": "number"}, "local_f32": {"$ref": "#/$defs/f32"}, "source": {"type": "number"},
        "effective_source": {"type": "number"}, "sides": {"type": "array", "items": {"enum": ["left", "right"]}},
        "muscles_f32": {"type": "array", "items": {"$ref": "#/$defs/f32"}},
        "pose": {"$ref": "#/$defs/pose"}
      }
    },
    "playback": {
      "type": "object", "additionalProperties": false,
      "required": ["api", "reset", "wrap_mode", "clip_looping", "clip_human_motion", "speed", "delta_time", "apply_root_motion", "foot_ik", "playable_ik", "animator_move", "controller_blending", "events", "legacy_state", "clip_length_f32", "frame_rate_f32"],
      "properties": {
        "api": {"enum": ["AnimationClipPlayable", "Animation.Sample", "HumanPoseHandler.SetHumanPose"]},
        "reset": {"const": "fresh_prefab"}, "wrap_mode": {"$ref": "#/$defs/name"}, "clip_looping": {"type": "boolean"},
        "clip_human_motion": {"type": "boolean"},
        "speed": {"const": 1}, "delta_time": {"const": 0}, "apply_root_motion": {"const": false},
        "foot_ik": {"const": false}, "playable_ik": {"const": false}, "animator_move": {"const": false},
        "controller_blending": {"const": false}, "events": {"const": false},
        "legacy_state": {"enum": ["enabled_weight_one_clamp_forever", "unused"]},
        "clip_length_f32": {"$ref": "#/$defs/f32"}, "frame_rate_f32": {"$ref": "#/$defs/f32"}
      }
    },
    "capture": {
      "type": "object", "additionalProperties": false,
      "required": ["editor_version", "build_target", "bundle_sha256", "playback", "clip_settings", "rest", "samples"],
      "properties": {
        "editor_version": {"type": "string", "pattern": "^(2022\\.3|6000\\.[0-9]+)\\.[0-9]+[abfp][0-9]+$"},
        "build_target": {"$ref": "#/$defs/name"},
        "bundle_sha256": {"type": "array", "items": {"$ref": "#/$defs/digest"}},
        "playback": {"$ref": "#/$defs/playback"}, "clip_settings": {"$ref": "#/$defs/clip_settings"},
        "rest": {"$ref": "#/$defs/pose"},
        "samples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sample"}},
        "humanoid": {"$ref": "#/$defs/human_capture"}
      }
    },
    "clip_settings": {
      "type": "object", "additionalProperties": false,
      "required": ["startTime", "stopTime", "orientationOffsetY", "level", "cycleOffset", "additiveReferencePoseTime", "additiveReferencePoseClipName",
        "loopTime", "loopBlend", "loopBlendOrientation", "loopBlendPositionY", "loopBlendPositionXZ",
        "keepOriginalOrientation", "keepOriginalPositionY", "keepOriginalPositionXZ", "heightFromFeet", "mirror", "hasAdditiveReferencePose"],
      "properties": {
        "startTime": {"$ref": "#/$defs/f32"}, "stopTime": {"$ref": "#/$defs/f32"}, "orientationOffsetY": {"$ref": "#/$defs/f32"},
        "level": {"$ref": "#/$defs/f32"}, "cycleOffset": {"$ref": "#/$defs/f32"}, "additiveReferencePoseTime": {"$ref": "#/$defs/f32"},
        "additiveReferencePoseClipName": {"type": "string"},
        "loopTime": {"type": "boolean"}, "loopBlend": {"type": "boolean"}, "loopBlendOrientation": {"type": "boolean"},
        "loopBlendPositionY": {"type": "boolean"}, "loopBlendPositionXZ": {"type": "boolean"}, "keepOriginalOrientation": {"type": "boolean"},
        "keepOriginalPositionY": {"type": "boolean"}, "keepOriginalPositionXZ": {"type": "boolean"}, "heightFromFeet": {"type": "boolean"},
        "mirror": {"type": "boolean"}, "hasAdditiveReferencePose": {"type": "boolean"}
      }
    },
    "human_capture": {
      "type": "object", "additionalProperties": false,
      "required": ["bones", "muscles", "limits", "axis_properties", "rest_body_position", "rest_body_rotation", "rest_muscles", "human_scale",
        "upper_arm_twist", "lower_arm_twist", "upper_leg_twist", "lower_leg_twist", "arm_stretch", "leg_stretch", "feet_spacing", "translation_dof"],
      "properties": {
        "bones": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
          "required": ["name", "node", "required"], "properties": {"name": {"$ref": "#/$defs/name"},
            "node": {"type": "integer", "minimum": -1}, "required": {"type": "boolean"}}}},
        "muscles": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
          "required": ["name", "bone", "axis", "min", "max"], "properties": {"name": {"$ref": "#/$defs/name"}, "bone": {"$ref": "#/$defs/index"},
            "axis": {"type": "integer", "minimum": 0, "maximum": 2}, "min": {"$ref": "#/$defs/f32"}, "max": {"$ref": "#/$defs/f32"}}}},
        "limits": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["bone", "human", "axis_length", "min", "max", "center", "defaults"], "properties": {"bone": {"$ref": "#/$defs/name"},
            "human": {"$ref": "#/$defs/name"}, "axis_length": {"$ref": "#/$defs/f32"}, "min": {"$ref": "#/$defs/vec3"},
            "max": {"$ref": "#/$defs/vec3"}, "center": {"$ref": "#/$defs/vec3"}, "defaults": {"type": "boolean"}}}},
        "axis_properties": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["path", "kind", "value"], "properties": {"path": {"$ref": "#/$defs/name"},
            "kind": {"enum": ["Float", "Vector3", "Quaternion", "Integer"]},
            "value": {"type": "array", "items": {"$ref": "#/$defs/name"}}}}},
        "rest_body_position": {"$ref": "#/$defs/vec3"}, "rest_body_rotation": {"$ref": "#/$defs/vec4"},
        "rest_muscles": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/f32"}},
        "human_scale": {"$ref": "#/$defs/f32"}, "upper_arm_twist": {"$ref": "#/$defs/f32"}, "lower_arm_twist": {"$ref": "#/$defs/f32"},
        "upper_leg_twist": {"$ref": "#/$defs/f32"}, "lower_leg_twist": {"$ref": "#/$defs/f32"}, "arm_stretch": {"$ref": "#/$defs/f32"},
        "leg_stretch": {"$ref": "#/$defs/f32"}, "feet_spacing": {"$ref": "#/$defs/f32"}, "translation_dof": {"type": "boolean"}
      }
    }
  }
}
