{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/scobenes/unityrs/docs/batch/spec-v1.schema.json",
  "title": "unityrs batch job spec, version 1",
  "description": "Written by hand from docs/BATCH_SPEC.md section 1's tables. It states each field's type, range and presence; a byte cap only as a code-point bound (maxLength), which is looser; an integer as JSON Schema's integer, which also holds 1.0 where the parser takes only an integer token. The byte caps, a URL's serialized length, the header rules beyond a name's form, and every cross-field rule are the parser's alone (section 1, 1.1's cross-field rules).",
  "type": "object",
  "properties": {
    "spec_version": {"type": "integer", "minimum": 1, "maximum": 1},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^(?:[A-Za-z0-9_-][A-Za-z0-9._-]*|\\.[A-Za-z0-9_-][A-Za-z0-9._-]*|\\.\\.[A-Za-z0-9._-]+)?$"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "deadline": {"type": ["string", "null"], "format": "date-time", "default": null, "description": "Required (not null) with an object store sink (a cross-field rule)."},
    "shutdown_grace_ms": {"type": "integer", "minimum": 10000, "maximum": 600000, "default": 20000},
    "stop_on_stdin_eof": {"type": "boolean", "default": false},
    "parent_pid": {"type": ["integer", "null"], "minimum": 2, "maximum": 4194304, "default": null},
    "threads": {"type": "integer", "minimum": 1, "maximum": 1024},
    "download_concurrency": {"type": "integer", "minimum": 1, "maximum": 256},
    "max_inflight_uncompressed_bytes": {"type": "integer", "minimum": 67108864, "maximum": 1125899906842624},
    "max_decoded_bytes": {"type": "integer", "minimum": 1048576, "maximum": 1099511627776},
    "dep_cache_bytes": {"type": "integer", "minimum": 1048576, "maximum": 1099511627776},
    "max_view_bundles": {"type": "integer", "minimum": 1, "maximum": 65536, "default": 1024},
    "max_attempt_evictions": {"type": "integer", "minimum": 0, "maximum": 1048576, "default": 1024},
    "max_export_work": {"type": "integer", "minimum": 1048576, "maximum": 9007199254740991, "description": "Default: 2 x max_decoded_bytes (final)."},
    "spool": {"$ref": "#/$defs/Spool"},
    "http": {"$ref": "#/$defs/Http", "default": {}},
    "inputs": {"type": "array", "items": {"$ref": "#/$defs/Bundle"}, "minItems": 1, "maxItems": 100000},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/Bundle"}, "default": []},
    "outputs": {"$ref": "#/$defs/Outputs"},
    "prefer": {"type": "object", "additionalProperties": {"$ref": "#/$defs/Prefer"}, "default": {}},
    "publish_incomplete": {"type": "boolean", "default": true},
    "resume": {"type": "boolean", "default": false},
    "sink": {"oneOf": [{"$ref": "#/$defs/DirectorySink"}, {"$ref": "#/$defs/ObjectStoreSink"}]},
    "archives": {"type": "array", "items": {"$ref": "#/$defs/Archive"}, "maxItems": 256, "default": []},
    "manifest_fencing": {"type": "string", "enum": ["conditional", "none"], "default": "conditional"}
  },
  "required": [
    "spec_version", "run_id", "attempt", "threads", "download_concurrency",
    "max_inflight_uncompressed_bytes", "max_decoded_bytes", "dep_cache_bytes",
    "spool", "inputs", "outputs", "sink"
  ],
  "additionalProperties": false,
  "$defs": {
    "Bundle": {
      "description": "An item of inputs or dependencies (1.2): exactly one of path and url, headers only with url (cross-field rules).",
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"},
        "path": {"type": "string", "pattern": "^/[^\\u0000]*$"},
        "url": {"type": "string", "format": "uri", "maxLength": 16384, "pattern": "^[\\u0000-\\u007f]*$", "description": "ASCII, at most 16 KiB as written and as the url crate serializes it, its host as written at most 253 bytes; http or https, no userinfo."},
        "headers": {"$ref": "#/$defs/Headers", "default": {}},
        "size": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "deps": {"type": "array", "items": {"type": "string"}, "default": []}
      },
      "required": ["id"],
      "additionalProperties": false
    },
    "Headers": {
      "description": "Header name to a literal value or an environment variable. Names and literal values total at most 64 KiB; names are compared ASCII case-insensitively for duplicates (the parser's).",
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$",
        "not": {"pattern": "^([Hh][Oo][Ss][Tt]|[Cc][Oo][Nn][Tt][Ee][Nn][Tt]-[Ll][Ee][Nn][Gg][Tt][Hh]|[Tt][Rr][Aa][Nn][Ss][Ff][Ee][Rr]-[Ee][Nn][Cc][Oo][Dd][Ii][Nn][Gg]|[Cc][Oo][Nn][Nn][Ee][Cc][Tt][Ii][Oo][Nn]|[Rr][Aa][Nn][Gg][Ee]|[Aa][Cc][Cc][Ee][Pp][Tt]-[Ee][Nn][Cc][Oo][Dd][Ii][Nn][Gg])$"}
      },
      "additionalProperties": {
        "anyOf": [
          {"type": "string", "maxLength": 16384, "pattern": "^[^\\u0000-\\u0008\\u000a-\\u001f\\u007f]*$"},
          {"$ref": "#/$defs/Env"}
        ]
      }
    },
    "Env": {
      "type": "object",
      "properties": {
        "env": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
      },
      "required": ["env"],
      "additionalProperties": false
    },
    "Spool": {
      "type": "object",
      "properties": {
        "dir": {"type": "string", "maxLength": 256, "pattern": "^/[^\\u0000]*$"},
        "size_bytes": {"type": "integer", "minimum": 1048576, "maximum": 9007199254740991},
        "reserve_bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      },
      "required": ["dir", "size_bytes", "reserve_bytes"],
      "additionalProperties": false
    },
    "Http": {
      "description": "backoff_max_ms is at least backoff_initial_ms (a cross-field rule).",
      "type": "object",
      "properties": {
        "idle_timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 600000, "default": 30000},
        "min_rate_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824, "default": 1024},
        "connect_timeout_ms": {"type": "integer", "minimum": 100, "maximum": 60000, "default": 10000},
        "attempts": {"type": "integer", "minimum": 1, "maximum": 10, "default": 3},
        "backoff_initial_ms": {"type": "integer", "minimum": 0, "maximum": 60000, "default": 500},
        "backoff_max_ms": {"type": "integer", "minimum": 0, "maximum": 600000, "default": 30000},
        "retry_on": {
          "type": "array",
          "items": {"type": "string", "enum": ["connect", "no_response", "timeout", "truncated", "status_5xx", "status_429"]},
          "uniqueItems": true,
          "default": ["connect", "no_response", "timeout", "truncated", "status_5xx", "status_429"]
        },
        "redirects": {"type": "string", "enum": ["same_origin", "none"], "default": "same_origin"}
      },
      "required": [],
      "additionalProperties": false
    },
    "Outputs": {
      "description": "At least one of the three (a cross-field rule).",
      "type": "object",
      "properties": {
        "textures": {"$ref": "#/$defs/KeyOnly"},
        "sprites": {"$ref": "#/$defs/KeyOnly"},
        "atlases": {"$ref": "#/$defs/Atlases"}
      },
      "required": [],
      "additionalProperties": false
    },
    "KeyOnly": {
      "type": "object",
      "properties": {
        "key": {"type": "string", "description": "A template (2.1)."}
      },
      "required": ["key"],
      "additionalProperties": false
    },
    "Atlases": {
      "type": "object",
      "properties": {
        "sprite_key": {"type": "string", "description": "A template (2.1)."},
        "json_key": {"type": "string", "description": "A template (2.1)."},
        "script_classes": {"type": "array", "items": {"$ref": "#/$defs/AtlasName"}, "minItems": 1, "maxItems": 256, "default": ["NGUIAtlas"]},
        "skip_name_suffixes": {"type": "array", "items": {"$ref": "#/$defs/AtlasName"}, "maxItems": 256, "default": []}
      },
      "required": ["sprite_key", "json_key"],
      "additionalProperties": false
    },
    "AtlasName": {
      "description": "A script class's name, or a sprite name's suffix (1.5).",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "Prefer": {
      "description": "At least one not null (a cross-field rule); input names an input.",
      "type": "object",
      "properties": {
        "input": {"type": ["string", "null"], "default": null},
        "md5": {"type": ["string", "null"], "pattern": "^[0-9a-f]{32}$", "default": null}
      },
      "required": [],
      "additionalProperties": false
    },
    "DirectorySink": {
      "type": "object",
      "properties": {
        "kind": {"type": "string", "enum": ["directory"]},
        "root": {"type": "string", "pattern": "^/[^\\u0000]*$"}
      },
      "required": ["kind", "root"],
      "additionalProperties": false
    },
    "ObjectStoreSink": {
      "description": "An IP-address endpoint, or a bucket with an uppercase letter or _, needs path_style true (a cross-field rule).",
      "type": "object",
      "properties": {
        "kind": {"type": "string", "enum": ["object_store"]},
        "bucket": {"type": "string", "minLength": 3, "maxLength": 255, "pattern": "^[A-Za-z0-9._-]*$"},
        "region": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_-]*$"},
        "prefix": {"type": "string", "maxLength": 512, "pattern": "^(?:[\\s\\S]*/)?$", "default": ""},
        "endpoint": {"type": ["string", "null"], "format": "uri", "maxLength": 1024, "pattern": "^[\\u0000-\\u007f]*$", "default": null, "description": "ASCII, at most 1 KiB as written and as the url crate serializes it, its host as written at most 253 bytes; http or https, no userinfo, query or fragment, its path empty or /."},
        "path_style": {"type": "boolean", "default": false},
        "timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 300000, "default": 30000},
        "attempts": {"type": "integer", "minimum": 1, "maximum": 10, "default": 3}
      },
      "required": ["kind", "bucket", "region"],
      "additionalProperties": false
    },
    "Archive": {
      "description": "Keys unique, none an ancestor of another; each member kind once (cross-field rules).",
      "type": "object",
      "properties": {
        "key": {"type": "string"},
        "members": {"type": "array", "items": {"$ref": "#/$defs/Member"}, "minItems": 1, "maxItems": 4}
      },
      "required": ["key", "members"],
      "additionalProperties": false
    },
    "Member": {
      "type": "object",
      "properties": {
        "kind": {"type": "string", "enum": ["texture", "sprite", "atlas_sprite", "atlas_json"]},
        "path": {"type": "string", "description": "A template (2.1)."}
      },
      "required": ["kind", "path"],
      "additionalProperties": false
    }
  }
}
