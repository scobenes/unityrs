{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "record": {
      "type": "object",
      "if": {"type": "object", "properties": {"kind": {"const": "whole-run"}}},
      "then": {"type": "object", "required": ["whole_run_coverage"]},
      "else": {"type": "object", "properties": {"whole_run_coverage": false}},
      "additionalProperties": false,
      "required": [
        "target",
        "profile",
        "sink",
        "provenance",
        "coverage",
        "coefficients",
        "structural_floors",
        "fixed_envelopes",
        "attribution",
        "kind"
      ],
      "properties": {
        "target": {"type": "string", "enum": ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu"]},
        "profile": {"type": "string", "enum": ["debug", "release"]},
        "sink": {"type": "string", "enum": ["directory", "store"]},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revision",
            "lockfile_sha256",
            "rustc",
            "glibc",
            "kernel",
            "native_libraries_sha256",
            "features",
            "allocator",
            "native",
            "page_size",
            "mmap_threshold",
            "arena_extra",
            "clean",
            "native_compilers",
            "native_flags_sha256"
          ],
          "properties": {
            "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "lockfile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "rustc": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
            },
            "glibc": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
            },
            "kernel": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
            },
            "native_libraries_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "features": {"type": "string", "const": "test-hooks"},
            "allocator": {"type": "string", "const": "system-glibc"},
            "native": {"type": "boolean"},
            "page_size": {"type": "integer", "const": 4096},
            "mmap_threshold": {"type": "integer", "const": 131072},
            "arena_extra": {"type": "integer", "const": 2},
            "clean": {"type": "boolean"},
            "native_flags_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "native_compilers": {
              "type": "object",
              "additionalProperties": false,
              "required": ["c", "cxx"],
              "properties": {
                "c": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
                },
                "cxx": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
                }
              }
            }
          }
        },
        "whole_run_coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "both-builds", "one-worker", "eight-workers", "resume",
            "loose", "archive", "phase-seven", "component-probes", "store-roundtrip"
          ],
          "properties": {
            "both-builds": {"type": "boolean"},
            "one-worker": {"type": "boolean"},
            "eight-workers": {"type": "boolean"},
            "resume": {"type": "boolean"},
            "loose": {"type": "boolean"},
            "archive": {"type": "boolean"},
            "phase-seven": {"type": "boolean"},
            "component-probes": {"type": "boolean"},
            "store-roundtrip": {"type": "boolean"}
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "worker-count",
            "pool-controller",
            "pool-finisher",
            "environment",
            "full-dispatch-channel",
            "full-end-channel",
            "base-startup",
            "base-failed-input",
            "base-archive",
            "base-old-journal",
            "base-resume",
            "base-lookup",
            "normal-run",
            "loose-publication",
            "zip-publication",
            "http-tls",
            "view-paths",
            "header-ownership",
            "scale-residual",
            "native-components",
            "retention",
            "store-multipart",
            "store-list",
            "store-verification",
            "store-journal",
            "store-final-head",
            "stop-phase-1",
            "stop-phase-2",
            "stop-phase-3",
            "stop-phase-4",
            "stop-phase-5",
            "stop-phase-6",
            "stop-phase-7"
          ],
          "properties": {
            "worker-count": {"type": "boolean"},
            "pool-controller": {"type": "boolean"},
            "pool-finisher": {"type": "boolean"},
            "environment": {"type": "boolean"},
            "full-dispatch-channel": {"type": "boolean"},
            "full-end-channel": {"type": "boolean"},
            "base-startup": {"type": "boolean"},
            "base-failed-input": {"type": "boolean"},
            "base-archive": {"type": "boolean"},
            "base-old-journal": {"type": "boolean"},
            "base-resume": {"type": "boolean"},
            "base-lookup": {"type": "boolean"},
            "normal-run": {"type": "boolean"},
            "loose-publication": {"type": "boolean"},
            "zip-publication": {"type": "boolean"},
            "http-tls": {"type": "boolean"},
            "view-paths": {"type": "boolean"},
            "header-ownership": {"type": "boolean"},
            "scale-residual": {"type": "boolean"},
            "native-components": {"type": "boolean"},
            "retention": {"type": "boolean"},
            "store-multipart": {"type": "boolean"},
            "store-list": {"type": "boolean"},
            "store-verification": {"type": "boolean"},
            "store-journal": {"type": "boolean"},
            "store-final-head": {"type": "boolean"},
            "stop-phase-1": {"type": "boolean"},
            "stop-phase-2": {"type": "boolean"},
            "stop-phase-3": {"type": "boolean"},
            "stop-phase-4": {"type": "boolean"},
            "stop-phase-5": {"type": "boolean"},
            "stop-phase-6": {"type": "boolean"},
            "stop-phase-7": {"type": "boolean"}
          }
        },
        "coefficients": {
          "type": "object",
          "additionalProperties": false,
          "required": ["c_base", "c_env", "m_thread", "m_pool", "m_dispatch", "m_end"],
          "properties": {
            "c_base": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "c_env": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "m_thread": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "m_pool": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "m_dispatch": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "m_end": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
          }
        },
        "structural_floors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["m_dispatch", "m_end"],
          "properties": {
            "m_dispatch": {"type": "integer", "minimum": 64, "maximum": 18446744073709551615},
            "m_end": {"type": "integer", "minimum": 3328, "maximum": 18446744073709551615}
          }
        },
        "fixed_envelopes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "connection",
            "finisher",
            "view_member",
            "header_table_entry",
            "mask_entry",
            "header_copies",
            "credential_holders",
            "credential_id",
            "credential_secret",
            "credential_token",
            "multipart_list",
            "response_body",
            "worker_state",
            "panic_slot",
            "abort_pair",
            "journal_line",
            "archive_resume_entry"
          ],
          "properties": {
            "connection": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "finisher": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "view_member": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "header_table_entry": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "mask_entry": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "header_copies": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "credential_holders": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "credential_id": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "credential_secret": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "credential_token": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "multipart_list": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "response_body": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "worker_state": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "panic_slot": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "abort_pair": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "journal_line": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "archive_resume_entry": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
          }
        },
        "attribution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "base_workers",
            "base_download_concurrency",
            "held_charges_only",
            "live_deductions_only",
            "raw_incremental_coefficients",
            "native_only_charges_excluded",
            "observer_allocation_free",
            "coherent_observations",
            "peer_excluded",
            "parent_startup_included"
          ],
          "properties": {
            "base_workers": {"type": "integer", "const": 1},
            "base_download_concurrency": {"type": "integer", "const": 1},
            "held_charges_only": {"type": "boolean", "const": true},
            "live_deductions_only": {"type": "boolean", "const": true},
            "raw_incremental_coefficients": {"type": "boolean", "const": true},
            "native_only_charges_excluded": {"type": "boolean", "const": true},
            "observer_allocation_free": {"type": "boolean", "const": true},
            "coherent_observations": {"type": "boolean", "const": true},
            "peer_excluded": {"type": "boolean", "const": true},
            "parent_startup_included": {"type": "boolean", "const": true}
          }
        },
        "kind": {"type": "string", "enum": ["synthetic", "whole-run"]}
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "records", "shipping_replacement", "pending", "coefficients"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "status": {"type": "string", "enum": ["provisional-b12b", "final"]},
    "records": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/record"}},
    "shipping_replacement": {"type": "boolean"},
    "pending": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 5,
      "items": {
        "type": "string",
        "enum": ["native-matrix", "store-calibration", "stop-calibration", "scene-coverage", "whole-run-matrix", "final-acceptance"]
      }
    },
    "coefficients": {
      "type": "object",
      "additionalProperties": false,
      "required": ["c_base", "c_env", "m_thread", "m_pool", "m_dispatch", "m_end"],
      "properties": {
        "c_base": {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw", "margin", "structural_floor", "selected"],
          "properties": {
            "raw": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "margin": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "structural_floor": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "selected": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
          }
        },
        "c_env": {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw", "margin", "structural_floor", "selected"],
          "properties": {
            "raw": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "margin": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "structural_floor": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "selected": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
          }
        },
        "m_thread": {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw", "margin", "structural_floor", "selected"],
          "properties": {
            "raw": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "margin": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "structural_floor": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "selected": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
          }
        },
        "m_pool": {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw", "margin", "structural_floor", "selected"],
          "properties": {
            "raw": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "margin": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "structural_floor": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "selected": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
          }
        },
        "m_dispatch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw", "margin", "structural_floor", "selected"],
          "properties": {
            "raw": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "margin": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "structural_floor": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "selected": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
          }
        },
        "m_end": {
          "type": "object",
          "additionalProperties": false,
          "required": ["raw", "margin", "structural_floor", "selected"],
          "properties": {
            "raw": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "margin": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "structural_floor": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
            "selected": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615}
          }
        }
      }
    }
  }
}
